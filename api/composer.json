{
  "name": "cwot/api",
  "description": "CW Operator Trainer sync API (Slim + MariaDB + JWT)",
  "type": "project",
  "license": "AGPL-3.0-or-later",
  "require": {
    "php": ">=8.2",
    "firebase/php-jwt": "^6.10",
    "lbuchs/webauthn": "^2.2",
    "phpmailer/phpmailer": "^6.9",
    "slim/psr7": "^1.7",
    "slim/slim": "^4.14",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "Cwot\\Api\\": "src/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
