APP_ENV=local
APP_DEBUG=1

# MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cwot
DB_USER=cwot
DB_PASS=secret

# JWT (change in production; use a long random string)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ISSUER=cwot-api
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000

# CORS (comma-separated origins; * allowed for local only)
# Production example: https://cwot.jp,http://localhost:3020
CORS_ORIGIN=http://localhost:3020

# WebAuthn / Passkeys (rpId = host only, no port/scheme)
# Production: WEBAUTHN_RP_ID=cwot.jp, WEBAUTHN_ORIGIN=https://cwot.jp
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME="CW Operator Trainer"
WEBAUTHN_ORIGIN=http://localhost:3020

# Frontend deep links in mail (no trailing slash)
# Production: FRONTEND_URL=https://cwot.jp
FRONTEND_URL=http://localhost:3020

# Mail (PHPMailer). SMTP required. MAIL_* or SMTP_* both work.
MAIL_FROM=csr@example.com
MAIL_FROM_NAME="CW Operator Trainer"
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=csr@example.com
MAIL_PASSWORD=app-password-here

# Contact form recipient (admin). Defaults to MAIL_FROM when unset.
# CONTACT_TO=admin@example.com
