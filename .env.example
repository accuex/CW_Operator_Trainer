# Google Analytics 4 Measurement ID (optional)
# Leave unset to disable GA. Required at build time for production tracking.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sync API (Slim on production). Local PHP API is not used by default.
# NEXT_PUBLIC_API_BASE_URL=https://cwot.jp

# Public site origin for metadata, robots.txt and sitemap.xml.
# SITE_URL=https://cwot.jp
