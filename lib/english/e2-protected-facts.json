{
  "root": {
    "schemaVersion": 1,
    "masterVersion": "E2-v1",
    "qualification": "第一級総合無線通信士",
    "tier_counts": {
      "minimum": 32,
      "standard": 74,
      "extended": 101
    },
    "groups": [
      {
        "id": "actors",
        "title": "誰が通信するか",
        "goal": "主体と役割を分け、船長・主管庁・救助機関を通信局と混同しない"
      },
      {
        "id": "distress",
        "title": "遭難・緊急と救助",
        "goal": "警報→受信確認→中継→救助と通常通信の違いをつなぐ"
      },
      {
        "id": "operations",
        "title": "周波数を聴守・運用する",
        "goal": "何を聴守し、何を止め、どの通信を中継するのかを読む"
      },
      {
        "id": "port",
        "title": "港へ入り、係留し、出港する",
        "goal": "港・左舷、錨地・係留場所、余裕水深・橋の高さ、次寄港地と目的地を区別"
      },
      {
        "id": "condition",
        "title": "船の状態・進路・視界を読む",
        "goal": "視界とその変化、操船制約・絡まり・揺れ・座礁を区別する"
      },
      {
        "id": "aviation",
        "title": "一総通で出た航空通信規定",
        "goal": "複数周波数聴守・通信中継・公衆通信・標準句・受信障害の扱いを読む"
      },
      {
        "id": "rules",
        "title": "規定の条件と例外を読む",
        "goal": "主体→義務/禁止/許可→条件/例外→時系列/下限を場面に沿って読む"
      },
      {
        "id": "structure",
        "title": "少数の船体語を補う",
        "goal": "一記事の説明を短い部位・働きに結ぶ補助。船舶工学の章にはしない"
      }
    ],
    "frequency_definition": "E0の表記パターン検出値。専門義のみの出現回数ではありません。",
    "modality_definition": "採用した意味の根拠資料がリーディング／英会話のどちらにあるか。音声認識難易度・放送された語数は示しません。",
    "example_definition": "例文は教材用の自作。実際の運用指示・現行規則を提示するものではありません。",
    "impact_scale": {
      "A": "大意・主体・規定の結論を失う可能性",
      "B": "一部の情報・条件を失う可能性",
      "C": "本文の説明から推測できる",
      "D": "知らなくてもほぼ困らない"
    },
